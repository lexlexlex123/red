Options -Indexes +FollowSymLinks
RewriteEngine on
RewriteBase /

# Блокировка вредоносных скриптов
RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [NC]
RewriteRule .* - [F]

# PWA: MIME
AddType application/manifest+json .webmanifest
AddType application/vnd.slides.project+json .slides.json
AddType application/javascript .js
AddType image/png .png
AddType image/svg+xml .svg
AddType application/wasm .wasm

<IfModule mod_headers.c>
  <Files "manifest.webmanifest">
    Header set Content-Type "application/manifest+json"
  </Files>
</IfModule>

# Корневые PNG ↔ icons/ (только если файл есть в другом месте)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/icons/icon-192.png -f
RewriteRule ^icon-192\.png$ icons/icon-192.png [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/icons/icon-512.png -f
RewriteRule ^icon-512\.png$ icons/icon-512.png [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/icon-192.png -f
RewriteRule ^icons/icon-192\.png$ icon-192.png [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/icon-512.png -f
RewriteRule ^icons/icon-512\.png$ icon-512.png [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/icons/icon.svg -f
RewriteRule ^icon\.svg$ icons/icon.svg [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/icon.svg -f
RewriteRule ^icons/icon\.svg$ icon.svg [L]

# SPA fallback — не подменять отсутствующие статические файлы HTML-страницей
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(png|jpg|jpeg|gif|svg|ico|webp|webmanifest|wasm|css|js|json|woff2?|ttf|eot|mp3|mp4|webm|pdf|pptx?|zip)$ [NC]
RewriteRule ^(.*)$ /index.html [L]

ErrorDocument 404 /index.html
ErrorDocument 403 /index.html
DirectorySlash Off
